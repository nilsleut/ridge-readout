# Copy to .env.local (gitignored) and fill in. src/ridge/paths.py reads the process
# environment first, then .env.local. Use forward slashes on Windows.

# THINGS-fMRI directory with sub-XX_task-things_voxel-wise-responses.h5 and the voxel/stimulus metadata CSVs
THINGS_FMRI_DIR=
# THINGS object_images directory (one folder per concept)
THINGS_IMAGES_DIR=
# outputs_720 directory with stim_order_sub-XX.txt and fmri_rdm_*.npy
OUTPUTS_720_DIR=
# Local checkpoint directory used as the load_model() default (BN-fixed seed-0 checkpoints)
CKPT_DIR=
# Root of the learning-rules-rsa repository (cross-run analysis)
CROSSRUN_REPO=
# Directory containing arm_b_out/ and pilot_features/ (see DATA_MANIFEST.txt)
RIDGE_DATA_DIR=
# Directory with the 30 v12 checkpoints (6 conditions x 5 seeds)
CKPT_V12_DIR=
# Published results/bnfix_sweep.csv of evaluation-resolution-rsa
BNFIX_SWEEP_CSV=
# Output directory for the step 5 GAP features (written; keep it outside read-only repos)
STEP5_GAP_DIR=
